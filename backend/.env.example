APP_NAME=Ihyaa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

# جدول إعادة تعيين كلمة المرور (docs/database/migrations.md §0.8)
AUTH_PASSWORD_RESET_TOKEN_TABLE=password_resets

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# ——— الذكاء الاصطناعي (config/ai.php) ———
AI_MOCK=true
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
AI_CLAUDE_API_KEY=
AI_CLAUDE_MODEL=claude-3-5-haiku-latest

# ——— Meilisearch (config/scout.php — Sprint 2) ———
# SCOUT_DRIVER=collection يعني null في Sprint 1 (قراءة من MySQL مباشرة)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=
SCOUT_DRIVER=collection

# ——— Reverb (WebSocket — أحداث حرجة فقط) ———
# REVERB_SERVER_HOST=127.0.0.1
# REVERB_SERVER_PORT=8080
# REVERB_APP_ID=ihyaa
# REVERB_APP_KEY=ihyaa-key
# REVERB_APP_SECRET=ihyaa-secret

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
